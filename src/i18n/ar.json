      "items": {
        "howItWorks": {
          "q": "كيف يعمل Handiman للمستخدمين؟",
          "a": "يبسّط Handiman العملية للمستخدمين. سجّل، تصفح الخدمات، اختر ما تحتاجه، أرسل طلبك، تواصل مع مقدم الخدمة، واستمتع بخدمة من الطراز الأول. تضمن فرقنا المتخصصة تجربة سلسة، وملاحظاتك محل تقدير دائمًا"
        },
        "servicesOffered": {
          "q": "ما الخدمات المتوفرة على Handiman؟",
          "a": "يقدّم Handiman مجموعة متنوعة من الخدمات، منها على سبيل المثال لا الحصر صيانة المنزل، الدعم التقني، التنظيف، السباكة، تنسيق الحدائق، علاجات التجميل، التوصيل، تنظيم الفعاليات، الفنون الإبداعية، اللياقة البدنية، والاستشارات المهنية."
        },
        "vendorsJoin": {
          "q": "كيف ينضم مقدمو الخدمة إلى Handiman؟",
          "a": "يمكن لمقدمي الخدمة الانضمام إلى Handiman بسهولة عبر التسجيل، وعرض خدماتهم، والانضمام إلى مجتمعنا. توفر منصتنا مساحة لمقدمي الخدمة للتواصل مع المستخدمين وتقديم خدمات استثنائية."
        },
        "whatSetsApart": {
          "q": "ما الذي يميز Handiman عن منصات الخدمات الأخرى عند الطلب؟",
          "a": "يتميز Handiman بواجهته سهلة الاستخدام، وفرقه المتخصصة لمقدمي الخدمة وأصحاب الأعمال، وحلوله المناسبة للميزانية، وتسعيره الشفاف، ونهجه الذي يركز على المجتمع. نولي الابتكار الأولوية ونسعى لجعل كل تجربة خدمة استثنائية"
        },
        "mobileApps": {
          "q": "هل Handiman متاح على الأجهزة المحمولة؟",
          "a": "نعم، Handiman متاح على منصتي أندرويد وiOS. يمكن للمستخدمين ومقدمي الخدمة الوصول إلى المنصة بسلاسة من خلال تطبيقاتنا سهلة الاستخدام، مما يضمن الراحة أثناء التنقل"
        }
      }
