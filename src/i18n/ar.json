        "graceOkafor": {
          "name": "Grace Okafor",
          "role": "مديرة عقارات",
          "quote": "أدير أحد عشر شقة، وكنت أحتفظ بجدول بيانات للحرفيين. الآن كل مهمة وفاتورة وصورة في مكان واحد، ويمكنني تسليم مالك العقار السجل الكامل بنقرة واحدة."
        },
        "lukeMendes": {
          "name": "Luke Mendes",
          "role": "سباك، مقدم خدمة",
          "quote": "بصفتي مقدم خدمة، الفرق هو عدم الحاجة لملاحقة أحد. تصلني المهمة، أقبلها، وتُسوّى الدفعة في المساء نفسه. هذا الانتظام هو كل ما يهم."
        },
        "hannahBell": {
          "name": "Hannah Bell",
          "role": "مشترية تجزئة",
          "quote": "أرسل طرودًا إلى ثلاثة متاجر كل أسبوع. التتبع المباشر يعني أنني لم أعد أتلقى مكالمات \"هل وصل بعد؟\"، وصورة إثبات التسليم قد حسمت بالفعل نزاعين."
        },
        "devPatel": {
          "name": "Dev Patel",
          "role": "مالك منزل، مانشستر",
          "quote": "ما أقنعني هو التحقق الدقيق. يعرض كل ملف شخصي الفحوصات والتأمين وتقييمات حقيقية من مهام أُنجزت على هذه المنصة — وليس مجموعة نجوم مستوردة من مكان آخر."
        },
        "amaraSolis": {
          "name": "Amara Solis",
          "role": "مديرة استوديو",
          "quote": "حدث تسرب مياه مساء أحد أيام الأحد وتوقعت الانتظار حتى الاثنين. وصل شخص خلال أربعين دقيقة، وتم إطلاعي على سعر خارج أوقات الدوام مسبقًا بوضوح."
        },
