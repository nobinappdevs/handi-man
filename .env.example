# Base URL of the Handiman Laravel API. Every browser-visible var MUST be
# prefixed NEXT_PUBLIC_. Do NOT create a .env.local — it silently overrides
# this file and you end up debugging the wrong host.
NEXT_PUBLIC_API_URL=

# The vendor API is a separate root (…/api/vendor/v1, not …/api/v1). Leave this
# blank and it is derived from NEXT_PUBLIC_API_URL by swapping /api/v1 →
# /api/vendor/v1. Set it only when the vendor API is on a different host.
NEXT_PUBLIC_VENDOR_API_URL=

# Optional, per feature — realtime chat / web push (Pusher).
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
